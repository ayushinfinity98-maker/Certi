rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'ayushinfinity98@gmail.com')
      );
    }

    function isCA() {
      return isSignedIn() && exists(/databases/$(database)/documents/campusAmbassadors/$(request.auth.uid));
    }

    function isEmailAuthorizedForCa(caUid) {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/campusAmbassadors/$(caUid)) &&
        (
          (get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.googleEmail is string &&
            get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.googleEmail.lower() == request.auth.token.email.lower()) ||
          (get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.email is string &&
            get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.email.lower() == request.auth.token.email.lower())
        );
    }

    function isOwningCa(caUid) {
      return isSignedIn() && (request.auth.uid == caUid || isEmailAuthorizedForCa(caUid));
    }

    function isMainCa(caUid) {
      return isOwningCa(caUid) &&
        exists(/databases/$(database)/documents/campusAmbassadors/$(caUid)) &&
        get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.caRole == 'main_ca' &&
        get(/databases/$(database)/documents/campusAmbassadors/$(caUid)).data.status == 'active';
    }

    // Student Validation
    function isValidStudent(data) {
      return data.keys().hasAll(['caUid', 'fullName', 'email', 'college', 'semester', 'initiativeName', 'participationDate', 'certificateStatus']) &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() <= 120 &&
        data.college is string && data.college.size() <= 150 &&
        data.semester is string && data.semester.size() <= 50 &&
        data.initiativeName is string && data.initiativeName.size() <= 150 &&
        data.participationDate is string && data.participationDate.size() <= 50 &&
        data.certificateStatus in ['not_issued', 'issued', 'revoked'] &&
        data.caUid is string && data.caUid.size() <= 128;
    }

    // Certificate Validation
    function isValidCertificate(data) {
      return data.keys().hasAll(['certificateId', 'studentId', 'studentName', 'initiativeName', 'college', 'participationDate', 'caUid', 'caName', 'status']) &&
        data.certificateId is string && data.certificateId.size() <= 64 &&
        data.studentId is string && data.studentId.size() <= 128 &&
        data.studentName is string && data.studentName.size() <= 120 &&
        data.initiativeName is string && data.initiativeName.size() <= 150 &&
        data.college is string && data.college.size() <= 150 &&
        data.participationDate is string && data.participationDate.size() <= 50 &&
        data.caUid is string && data.caUid.size() <= 128 &&
        data.caName is string && data.caName.size() <= 120 &&
        data.status in ['valid', 'revoked'];
    }

    // Campus Ambassadors collection
    match /campusAmbassadors/{caUid} {
      // Allow reading so that login credentials and Google sign-ins can verify authorization without PERMISSION_DENIED
      allow get: if true;
      allow list: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email != null &&
        (
          resource.data.googleEmail == request.auth.token.email.lower() ||
          resource.data.email == request.auth.token.email.lower() ||
          resource.data.googleEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        )
      );
      allow write: if isAdmin();
    }

    // CA ID -> Email lookup directory (no passwords or PII) for CA ID login
    match /caDirectory/{caIdKey} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminUid} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == adminUid || (request.auth.token.email != null && request.auth.token.email.lower() == 'ayushinfinity98@gmail.com')));
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'ayushinfinity98@gmail.com');
    }

    // Students collection
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (isAdmin() || isOwningCa(resource.data.caUid));
      allow list: if isAdmin() || isOwningCa(resource.data.caUid);
      allow create: if isValidId(studentId) && (isAdmin() || isOwningCa(incoming().caUid)) && isValidStudent(incoming());
      allow update: if isValidId(studentId) && (isAdmin() || (isOwningCa(existing().caUid) && incoming().caUid == existing().caUid)) && isValidStudent(incoming());
      allow delete: if isValidId(studentId) && (isAdmin() || isOwningCa(existing().caUid));
    }

    // Certificates collection
    match /certificates/{certificateId} {
      // Public read for single certificate verification via QR code or ID lookup
      allow get: if isValidId(certificateId);
      // Listing restricted to Admin or the owning CA
      allow list: if isAdmin() || isOwningCa(resource.data.caUid);
      // Issuance
      allow create: if isValidId(certificateId) && (isAdmin() || isOwningCa(incoming().caUid)) && isValidCertificate(incoming());
      allow update: if isValidId(certificateId) && (isAdmin() || (isOwningCa(existing().caUid) && incoming().caUid == existing().caUid)) && isValidCertificate(incoming());
      allow delete: if isAdmin();
    }

    // Certificate Templates collection (Admin controlled designs and placeholders)
    match /certificateTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Email Templates collection
    match /emailTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Email Delivery Logs
    match /emailLogs/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || isOwningCa(resource.data.caUid));
      allow list: if isAdmin() || isOwningCa(resource.data.caUid);
      allow create: if isValidId(logId) && (isAdmin() || isOwningCa(incoming().caUid));
      allow update: if isValidId(logId) && (isAdmin() || isOwningCa(existing().caUid));
      allow delete: if isAdmin();
    }

    // Main CA Form Validation
    function isValidCaForm(data) {
      return data.keys().hasAll(['id', 'caUid', 'caId', 'title', 'isActive', 'fields']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.caUid is string && data.caUid.size() > 0 && data.caUid.size() <= 128 &&
        data.caId is string && data.caId.size() <= 32 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.isActive is bool &&
        data.fields is list && data.fields.size() <= 40;
    }

    // Public Form Submission Validation
    function isValidFormSubmission(data) {
      return data.keys().hasAll(['id', 'formId', 'caUid', 'fullName', 'email', 'college', 'initiativeName', 'participationDate', 'status']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.formId is string && data.formId.size() > 0 && data.formId.size() <= 128 &&
        data.caUid is string && data.caUid.size() > 0 && data.caUid.size() <= 128 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() > 2 && data.email.size() <= 120 &&
        data.college is string && data.college.size() <= 150 &&
        data.initiativeName is string && data.initiativeName.size() <= 150 &&
        data.participationDate is string && data.participationDate.size() <= 50 &&
        data.status in ['pending', 'imported', 'rejected'] &&
        (!('formCreatorUid' in data) || (data.formCreatorUid is string && data.formCreatorUid.size() <= 128)) &&
        (!('referringCaName' in data) || (data.referringCaName is string && data.referringCaName.size() <= 120)) &&
        (!('customFields' in data) || data.customFields is map);
    }

    // Certificate Field / Placeholder Mapping Validation
    function isValidCertificateMapping(data) {
      return data.keys().hasAll(['id', 'roles']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.roles is list && data.roles.size() <= 60;
    }

    // Shareable Forms created by Main CA or Admin (Standard CAs can read active forms to share with assigned students)
    match /caForms/{formId} {
      allow get: if isValidId(formId);
      allow list: if isAdmin() || isOwningCa(resource.data.caUid) || (isSignedIn() && resource.data.isActive == true);
      allow create: if isValidId(formId) && isValidCaForm(incoming()) && (isAdmin() || isMainCa(incoming().caUid));
      allow update: if isValidId(formId) && isValidCaForm(incoming()) && incoming().caUid == existing().caUid && (isAdmin() || isMainCa(existing().caUid));
      allow delete: if isValidId(formId) && (isAdmin() || isMainCa(existing().caUid));
    }

    // Public student submissions (anyone with active form link can create; referring CA & form-creator Main CA & Admin can read)
    match /formSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        isAdmin() ||
        isOwningCa(resource.data.caUid) ||
        (resource.data.formCreatorUid is string && isMainCa(resource.data.formCreatorUid))
      );
      allow list: if isAdmin() ||
        isOwningCa(resource.data.caUid) ||
        (resource.data.formCreatorUid is string && isOwningCa(resource.data.formCreatorUid));
      allow create: if isValidId(submissionId) &&
        isValidFormSubmission(incoming()) &&
        incoming().status == 'pending' &&
        exists(/databases/$(database)/documents/caForms/$(incoming().formId)) &&
        get(/databases/$(database)/documents/caForms/$(incoming().formId)).data.isActive == true &&
        incoming().formCreatorUid is string &&
        incoming().formCreatorUid == get(/databases/$(database)/documents/caForms/$(incoming().formId)).data.caUid &&
        (
          incoming().caUid == get(/databases/$(database)/documents/caForms/$(incoming().formId)).data.caUid ||
          exists(/databases/$(database)/documents/campusAmbassadors/$(incoming().caUid))
        );
      allow update: if isValidId(submissionId) &&
        isValidFormSubmission(incoming()) &&
        incoming().caUid == existing().caUid &&
        (
          isAdmin() ||
          isOwningCa(existing().caUid) ||
          (existing().formCreatorUid is string && isMainCa(existing().formCreatorUid))
        );
      allow delete: if isValidId(submissionId) && (
        isAdmin() ||
        isOwningCa(existing().caUid) ||
        (existing().formCreatorUid is string && isMainCa(existing().formCreatorUid))
      );
    }

    // Placeholder roles & active certificate info configured by Main CA or Admin
    match /certificateMappings/{mappingId} {
      allow read: if true;
      allow create, update: if isValidId(mappingId) && isValidCertificateMapping(incoming()) && (
        isAdmin() || (incoming().updatedByCaUid is string && isMainCa(incoming().updatedByCaUid))
      );
      allow delete: if isAdmin();
    }

    // Immutable Audit Logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn() && (incoming().actorUid == request.auth.uid || isOwningCa(incoming().actorUid));
      allow update, delete: if false;
    }
  }
}
